# Copy to .env for local development. Use only non-secret configuration here.
# Keep passwords, tokens, API keys, and private keys out of this file.

# Database
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_SSLMODE=

# Object storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_USE_SSL=

# RabbitMQ
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_VHOST=

# JWT (issuer, audience, and algorithm only; never include signing keys)
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ALGORITHM=

# Model adapters
EXTRACTION_MODEL_PROVIDER=
EMBEDDING_MODEL_PROVIDER=
LANGUAGE_MODEL_PROVIDER=
DOCUMENT_PARSER_PROVIDER=

# Browser access
CORS_ALLOWED_ORIGINS=

# Telemetry
TELEMETRY_ENABLED=
TELEMETRY_SERVICE_NAME=
LOG_LEVEL=
